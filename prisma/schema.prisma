generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PRINCIPAL
  TEACHER
}

enum Stage {
  PRIMARY
  MIDDLE
  HIGH
}

enum TeacherSource {
  IMPORT
  SELF
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      Role
  schoolId  Int?
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model School {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  code        String        @unique
  stage       Stage
  classes     SchoolClass[]
  principals  User[]
  teachers    Teacher[]
  submissions Submission[]
  createdAt   DateTime      @default(now())
}

model SchoolClass {
  id          Int                  @id @default(autoincrement())
  schoolId    Int
  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade       String
  gradeOrder  Int
  name        String
  order       Int
  assignments TeachingAssignment[]
  submissions Submission[]

  @@unique([schoolId, grade, name])
}

model Subject {
  id          Int                  @id @default(autoincrement())
  name        String               @unique
  order       Int
  periods     PeriodSubject[]
  assignments TeachingAssignment[]
  answers     Answer[]
}

model Period {
  id          Int             @id @default(autoincrement())
  name        String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean         @default(true)
  subjects    PeriodSubject[]
  questions   Question[]
  submissions Submission[]
  createdAt   DateTime        @default(now())
}

model PeriodSubject {
  periodId  Int
  subjectId Int
  period    Period  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([periodId, subjectId])
}

model Question {
  id        Int      @id @default(autoincrement())
  periodId  Int
  period    Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  order     Int
  content   String
  options   Json
  createdAt DateTime @default(now())
  answers   Answer[]
}

model Teacher {
  id          Int                  @id @default(autoincrement())
  schoolId    Int
  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  phone       String               @unique
  source      TeacherSource
  createdAt   DateTime             @default(now())
  assignments TeachingAssignment[]
  answers     Answer[]
}

model TeachingAssignment {
  id        Int         @id @default(autoincrement())
  classId   Int
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId Int
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId Int
  teacher   Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
}

model Submission {
  id        Int         @id @default(autoincrement())
  periodId  Int
  period    Period      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  schoolId  Int
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   Int
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  answers   Answer[]

  @@index([periodId, schoolId])
}

model Answer {
  id           Int        @id @default(autoincrement())
  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   Int
  question     Question   @relation(fields: [questionId], references: [id], onDelete: NoAction)
  subjectId    Int
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId    Int
  teacher      Teacher    @relation(fields: [teacherId], references: [id], onDelete: NoAction)
  score        Int
  maxScore     Int

  @@unique([submissionId, questionId, subjectId])
  @@index([teacherId])
}
